{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "public-portfolio-site",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "env": {
    "preview": {
      "name": "public-portfolio-site-preview",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page"
      }
    }
  }
}
