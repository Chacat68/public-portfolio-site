---
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CallToAction from '../components/CallToAction.astro';
import { pageTag, pageDescription, aboutTdk } from '../data/content';

const portraitUrl =
	'https://blog-1259751088.cos.ap-shanghai.myqcloud.com/20260624134214913.webp?imageSlim';
---

<BlogPostLayout
	title={aboutTdk.title || ''}
	description={aboutTdk.description || ''}
	keywords={aboutTdk.keywords || ''}
>
	<div class="post">
		<main class="post-wrapper about">
			<SectionHeader tag={pageTag.about} description={pageDescription.about}>
				关于我
			</SectionHeader>
			<section class="border-top about-intro">
				<div class="content">
					<div class="about-portrait">
						<img src={portraitUrl} alt="王权" width="96" height="96" class="portrait" />
					</div>
					<p>
						我是 <strong>王权</strong>，产品与空间摄影师，品牌名<strong>观世界</strong>。
						专注用克制的光影呈现材质、尺度与使用场景，服务品牌主图、家装空间与影像短片。
					</p>
					<p>可合作范围包括：产品静物、室内与展陈空间、节气 / 品牌短片。欢迎先沟通品类、参考风格与档期。</p>
				</div>
			</section>
			<section>
				<h3 class="post-title">如何开始合作</h3>
				<div class="content">
					<p>请通过微信或邮件留言：品牌名称、拍摄对象、期望交付时间。通常 1 个工作日内回复。</p>
					<p class="about-actions">
						<button type="button" class="cta cta--primary wechat">微信预约</button>
						<CallToAction href="mailto:colinwangq@163.com" variant="secondary">发送邮件</CallToAction>
					</p>
					<p class="about-mail">
						<a href="mailto:colinwangq@163.com">colinwangq@163.com</a>
					</p>
				</div>
			</section>
		</main>
	</div>
</BlogPostLayout>

<style>
	.about {
		max-width: 720px;
	}

	.about-intro {
		padding-top: 2rem;
	}

	.about-portrait {
		text-align: center;
		margin-bottom: 1.5rem;
	}

	.portrait {
		border-radius: 50%;
		object-fit: cover;
	}

	.content p {
		margin-bottom: 1rem;
		line-height: 1.75;
		color: var(--color-200);
	}

	.about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem !important;
	}

	.about-mail {
		margin-top: 1rem;
		font-size: 0.9rem;
	}

	.cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 148px;
		padding: 0.95em 1.75em;
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.1;
		border-radius: var(--radius);
		border: 1px solid transparent;
		cursor: pointer;
		transition:
			background-color 0.25s ease,
			transform 0.25s ease;
	}

	.cta--primary {
		background: var(--gallery-ink, #1a1a1a);
		color: #f7f7f5;
		border-color: var(--gallery-ink, #1a1a1a);
	}

	.cta--primary:hover {
		background: #2a2a2a;
		transform: translateY(-1px);
	}

	:global(.theme-dark) .cta--primary {
		background: #f0f0ee;
		color: #141414;
		border-color: #f0f0ee;
	}
</style>
