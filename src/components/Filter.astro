---
import { filterItems } from '../data/content.ts';
const {count} = Astro.props;
---
<div class="section filter ">
	<div class="border-bottom">
		<div class="row filter-wrapper relative overflow-hidden col-1a">
			<ul class="flex filter-list filter-options">
				<button type="button" class="filter-item filter-tag active" data-group="all">
					全部 <span>({count})</span>
				</button>
                {filterItems.map((item) => (
                    <button type="button" class="filter-item filter-tag" data-group={item.dataGroup}>
                      {item.content}
                    </button>
                ))}
			</ul>
		</div>
	</div>
</div>


<style lang="scss">
:root{
    --filter-bg:  transparent;
    --filter-bg-active: transparent;
    --filter-bg-hover: transparent;
    --filter-color: var(--color-400);
    --filter-color-active: var(--color-0);
    --filter-border: none;
}
:root.theme-dark{
    --filter-bg:  transparent;
    --filter-color: var(--color-400);
    --filter-color-active: var(--color-0);
    --filter-border: none;
    --filter-bg-active: transparent;
    --filter-bg-hover: transparent;
}

.filter{
    &-wrapper{
        margin: 0.5rem 0 0.25rem;
    }
    &-list{
        display:flex;
        gap: 0.25rem 1.25rem;
        flex-wrap: wrap;
        justify-content: flex-start;
        margin: 0;
        padding: 0 0 0.75rem;
    }
    &-item{
        display: inline-flex;
    }
    &-tag{
        border-radius: 0;
        background-color: transparent;
        padding: 0.35rem 0;
        font-size: 0.875rem;
        font-family: var(--font-body);
        border: none;
        border-bottom: 1px solid transparent;
        line-height: 1.2;
        letter-spacing: 0.06em;
        color: var(--filter-color);
        text-align: center;
        cursor: pointer;
        transition: color 0.25s ease, border-color 0.25s ease;
        span{
            font-size: 0.7rem;
            font-weight: 300;
            padding: 0 0 0 0.2rem;
            vertical-align: baseline;
            opacity: 0.65;
            letter-spacing: 0;
        }
        &:hover{
            color: var(--color-200);
        }
        &.active{
            font-weight: 500;
            color: var(--filter-color-active);
            border-bottom-color: var(--color-0);
        }
    }
}
</style>
