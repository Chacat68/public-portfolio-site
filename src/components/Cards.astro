---
import Filter from '../components/Filter.astro';
// 引入 JSON 文件并加载数据
// const cardJsonString = '/assets/data/card.json';
// const cardData = JSON.parse(cardJsonString);
// 使用 JSON 数据
// import cardData from '../components/card.json';
import cardData from '../data/home.json';
const cards = [];
for (const [index,item] of cardData.entries()) {
  const extra = item as { images?: string[]; url?: string; detail?: string; ratio?: string };
  const card = {
    id: item.id || index,
    title: item.title,
    cover: item.cover || "",
    description: item.desc || "",
    url: extra.url || "",
    detail: extra.detail || "",
    category: item.category || "other",
    tag: item.tag || "",
    date: item.date || "",
    mark: item.mark|| "",
    hiRes: item.hiRes || "",
    // 单卡多图：优先用 images；否则用 hiRes 或 cover
    images: Array.isArray(extra.images) ? extra.images : [],
    video: item.video || "",
    // 封面比例，如 "3/4"、"16/9"；默认竖构图
    ratio: extra.ratio || (item.video ? "16/9" : "3/4"),
    index: index + 1,
  };
  cards.push(card);
}
// const cardFullData= JSON.stringify(cards);
const count = cards.length;
---
<Filter count={count} />
<div class="section card">
    <div class="card-list my-shuffle-container" id="js-shuffle">
            {cards.reverse().map((card, i) => (
              <div
                class="card-item col-1a col-md-2a col-lg-3a col-xxl-4a"
                style={`--stagger: ${i * 60}ms`}
                data-groups={JSON.stringify(String(card.category).split(',').map((s) => s.trim()).filter(Boolean))}
                data-date-created={card.date}
                data-title={card.title}
                data-full-img={card.hiRes || ""}
                data-images={JSON.stringify(
                  card.images.length
                    ? card.images
                    : [card.hiRes || card.cover].filter(Boolean)
                )}
                data-video={card.video || ""}
              >
                  <div class="card-body">
                      <a href={card.detail ? card.detail:"javascript:void(0)"} class="card-figure" style={`aspect-ratio: ${card.ratio}`} data-has-video={card.video ? "true" : undefined} target={card.detail ? "_blank":"_self"} rel={card.detail ? "noopener noreferrer" : undefined}>
                        <img class="card-figure__img lazy"
                              src={card.cover} loading="lazy"
                              alt={card.title}
                              referrerpolicy="no-referrer"
                        >
                      </a>
                  </div>
                  <div class="card-footer">
                      <div class="card-detail">
                          <a href={card.detail ? card.detail :"javascript:void(0)"} target={card.detail ? "_blank":"_self"} rel={card.detail ? "noopener noreferrer" : undefined} class="card-name card-item__title">
                            {card.mark && <span class="tag-original">精选</span>}{card.title}
                          </a>
                          <div class="card-meta">
                            <span class="card-tag">{card.tag}</span>
                            {card.description && <span class="card-info">{card.description}</span>}
                          </div>
                      </div>
                     {card.url && <a href={card.url ? card.url : "javascript:void(0)" } class="card-link card-link__go js-gotip" target={card.url ? "_blank" : "_self"} rel={card.url ? "noopener noreferrer" : undefined} aria-label="打开外链">
                      </a> }
                  </div>
              </div>
              ))}
        <!-- Shuffle 列宽参照：与卡片相同的栅格类，保证窄屏/多列计算正确 -->
        <div class="col-1a col-md-2a col-lg-3a col-xxl-4a my-sizer-element" id="my-sizer-element" aria-hidden="true"></div>
    </div>
</div>

<div class="lightbox" id="lightbox">
  <button type="button" class="lightbox-close" id="lightbox-close" aria-label="关闭">&times;</button>
  <button type="button" class="lightbox-nav lightbox-nav--prev" id="lightbox-prev" aria-label="上一张" hidden>‹</button>
  <button type="button" class="lightbox-nav lightbox-nav--next" id="lightbox-next" aria-label="下一张" hidden>›</button>
  <span class="lightbox-counter" id="lightbox-counter" hidden></span>
  <div class="lightbox-viewport" id="lightbox-viewport">
    <img class="lightbox-img" id="lightbox-img" src="" alt="" draggable="false" />
  </div>
  <div class="lightbox-player" id="lightbox-player">
    <iframe class="lightbox-video" id="lightbox-video" src="" title="视频播放" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture"></iframe>
    <a class="lightbox-video-fallback" id="lightbox-video-fallback" href="#" target="_blank" rel="noopener noreferrer">在 B 站打开</a>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
      // 检查是否存在带有类名 '.card-figure__video' 的元素
      const videos = document.querySelectorAll('.card-figure__video') as NodeListOf<HTMLVideoElement>;;

      // 如果存在视频元素，则执行相关操作
      if (videos.length > 0) {
          videos.forEach(video => {
              // 设置自动播放
              video.autoplay = true;
              // 禁止声音
              video.muted = true;
              // 循环播放
              video.loop = true;
              // 隐藏控制栏（包括进度条、播放/停止按钮和菜单栏）
              video.controls = false;
              // 设置 playsinline 属性，以确保在移动设备上也能自动播放
              video.setAttribute('playsinline', '');
              // 为了确保视频开始播放，我们可以添加一个 play() 调用
              video.play().catch(e => {
                  console.log("Auto-play was prevented:", e);
                  // 一些浏览器可能会阻止自动播放，特别是在没有用户交互的情况下
              });
          });
      } else {

      }
  });
</script>

<script is:inline type="module">
import '/plugins/shuffle.js';
var Shuffle = window.Shuffle;
class Demo {
  constructor(element) {
    this.element = element;
    this.shuffle = new Shuffle(element, {
      itemSelector: '.card-item',
      sizer: document.getElementById('my-sizer-element') });
    this._activeFilters = [];
    this.addFilterButtons();
    this.addSorting();
    this.addSearchFilter();
  }

  addFilterButtons() {
    const options = document.querySelector('.filter-options');
    if (!options) {
      return;
    }

    const filterButtons = Array.from(options.children);
    const onClick = this._handleFilterClick.bind(this);
    filterButtons.forEach(button => {
      button.addEventListener('click', onClick, false);
    });
  }

  _handleFilterClick(evt) {
    const btn = evt.currentTarget;
    const isActive = btn.classList.contains('active');
    const btnGroup = btn.getAttribute('data-group');

    this._removeActiveClassFromChildren(btn.parentNode);

    let filterGroup;
    if (isActive) {
      btn.classList.remove('active');
      filterGroup = Shuffle.ALL_ITEMS;
    } else {
      btn.classList.add('active');
      filterGroup = btnGroup;
    }

    this.shuffle.filter(filterGroup);
  }

  _removeActiveClassFromChildren(parent) {
    const { children } = parent;
    for (let i = children.length - 1; i >= 0; i--) {
      children[i].classList.remove('active');
    }
  }

  addSorting() {
    const buttonGroup = document.querySelector('.sort-options');
    if (!buttonGroup) {
      return;
    }
    buttonGroup.addEventListener('change', this._handleSortChange.bind(this));
  }

  _handleSortChange(evt) {
    // Add and remove `active` class from buttons.
    const buttons = Array.from(evt.currentTarget.children);
    buttons.forEach(button => {
      if (button.querySelector('input').value === evt.target.value) {
        button.classList.add('active');
      } else {
        button.classList.remove('active');
      }
    });

    // Create the sort options to give to Shuffle.
    const { value } = evt.target;
    let options = {};

    function sortByDate(element) {
      return element.getAttribute('data-created');
    }

    function sortByTitle(element) {
      return element.getAttribute('data-title').toLowerCase();
    }

    if (value === 'date-created') {
      options = {
        reverse: true,
        by: sortByDate };

    } else if (value === 'title') {
      options = {
        by: sortByTitle };

    }
    this.shuffle.sort(options);
  }

  // Advanced filtering
  addSearchFilter() {
    const searchInput = document.querySelector('.js-shuffle-search');
    if (!searchInput) {
      return;
    }
    searchInput.addEventListener('keyup', this._handleSearchKeyup.bind(this));
  }

  /**
   * Filter the shuffle instance by items with a title that matches the search input.
   * @param {Event} evt Event object.
   */
  _handleSearchKeyup(evt) {
    const searchText = evt.target.value.toLowerCase();
    this.shuffle.filter((element, shuffle) => {
      // If there is a current filter applied, ignore elements that don't match it.
      if (shuffle.group !== Shuffle.ALL_ITEMS) {
        // Get the item's groups.
        const groups = JSON.parse(element.getAttribute('data-groups'));
        const isElementInCurrentGroup = groups.indexOf(shuffle.group) !== -1;
        // Only search elements in the current group
        if (!isElementInCurrentGroup) {
          return false;
        }
      }
      const titleElement = element.querySelector('.card-item__title');
      const titleText = titleElement.textContent.toLowerCase().trim();
      return titleText.indexOf(searchText) !== -1;
    });
  }}
document.addEventListener('DOMContentLoaded', () => {
  window.demo = new Demo(document.getElementById('js-shuffle'));
});

</script>

<script>
// Lightbox — 图片按视口 100% 适配（无手动缩放）；多图左右切换；video 字段弹出播放
(function() {
  var lightbox = document.getElementById('lightbox')!;
  var lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  var lightboxPlayer = document.getElementById('lightbox-player') as HTMLDivElement;
  var lightboxVideo = document.getElementById('lightbox-video') as HTMLIFrameElement;
  var lightboxFallback = document.getElementById('lightbox-video-fallback') as HTMLAnchorElement;
  var lightboxClose = document.getElementById('lightbox-close') as HTMLElement;
  var prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
  var nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;
  var counterEl = document.getElementById('lightbox-counter') as HTMLElement;
  var viewport = document.getElementById('lightbox-viewport') as HTMLElement;
  if (!lightbox || !lightboxImg || !lightboxPlayer || !lightboxVideo || !viewport) return;

  var gallery: string[] = [];
  var galleryIndex = 0;
  var mode: 'image' | 'video' | null = null;
  var resizeTimer = 0;
  var layoutToken = 0;

  function isMulti() {
    return gallery.length > 1;
  }

  /** 挂到 body，避免祖先 transform / overflow 把 fixed 限制在作品区内 */
  function mountLightbox() {
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
  }

  function unmountScrollLock() {
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  }

  function clearInlineSize() {
    lightboxImg.style.width = '';
    lightboxImg.style.height = '';
    lightboxImg.style.maxWidth = '';
    lightboxImg.style.maxHeight = '';
    lightboxImg.style.transform = '';
  }

  /**
   * 按当前设备视口把图片适配到「显示 100%」：
   * - 普通图：contain 进可用区域，不放大超过原图像素
   * - 超长竖拼图：按可用宽度铺满，纵向滚动
   * 可选传入已解码尺寸，避免可见 img 尚未就绪时读到 0
   */
  function adaptImageLayout(nwOpt?: number, nhOpt?: number) {
    if (mode !== 'image') return;
    var nw = nwOpt || lightboxImg.naturalWidth || 0;
    var nh = nhOpt || lightboxImg.naturalHeight || 0;
    if (!nw || !nh) return false;

    clearInlineSize();

    var styles = getComputedStyle(viewport);
    var padX = (parseFloat(styles.paddingLeft) || 0) + (parseFloat(styles.paddingRight) || 0);
    var padY = (parseFloat(styles.paddingTop) || 0) + (parseFloat(styles.paddingBottom) || 0);
    var availW = Math.max(1, viewport.clientWidth - padX);
    var availH = Math.max(1, viewport.clientHeight - padY);
    var tallStrip = nh / nw > 2.2;

    viewport.classList.toggle('is-scrollable', tallStrip);

    if (tallStrip) {
      // 超长竖拼图：宽度铺满可用区域（手机/桌面一致按视口 100% 宽），高度随比例滚动
      lightboxImg.style.width = Math.round(availW) + 'px';
      lightboxImg.style.height = 'auto';
      lightboxImg.style.maxWidth = 'none';
      lightboxImg.style.maxHeight = 'none';
      return true;
    }

    // 普通图：contain 进可用区域，且不超过原图像素（显示 100%）
    var fit = Math.min(availW / nw, availH / nh, 1);
    lightboxImg.style.width = Math.round(nw * fit) + 'px';
    lightboxImg.style.height = Math.round(nh * fit) + 'px';
    lightboxImg.style.maxWidth = 'none';
    lightboxImg.style.maxHeight = 'none';
    return true;
  }

  function updateChrome() {
    var multi = isMulti();
    if (prevBtn) prevBtn.hidden = !multi;
    if (nextBtn) nextBtn.hidden = !multi;
    if (counterEl) {
      counterEl.hidden = !multi;
      counterEl.textContent = multi ? ((galleryIndex + 1) + ' / ' + gallery.length) : '';
    }
  }

  function finishImageLayout(src: string, token: number) {
    if (
      token !== layoutToken ||
      lightbox.style.display !== 'flex' ||
      gallery[galleryIndex] !== src ||
      mode !== 'image'
    ) {
      return;
    }
    var run = function() {
      if (token !== layoutToken || lightbox.style.display !== 'flex' || gallery[galleryIndex] !== src) {
        return;
      }
      if (adaptImageLayout()) lightboxImg.classList.add('loaded');
    };
    if (typeof lightboxImg.decode === 'function') {
      lightboxImg.decode().then(run).catch(run);
    } else {
      run();
    }
  }

  function showGalleryImage() {
    var src = gallery[galleryIndex];
    if (!src) return;
    var token = ++layoutToken;
    viewport.classList.remove('is-scrollable');
    clearInlineSize();
    lightboxImg.classList.remove('loaded');

    var onLoad = function() {
      lightboxImg.removeEventListener('load', onLoad);
      lightboxImg.removeEventListener('error', onError);
      finishImageLayout(src, token);
    };
    var onError = function() {
      lightboxImg.removeEventListener('load', onLoad);
      lightboxImg.removeEventListener('error', onError);
      if (token === layoutToken && lightbox.style.display === 'flex' && gallery[galleryIndex] === src) {
        lightboxImg.classList.add('loaded');
      }
    };

    // 先挂监听再赋 src，避免缓存命中时错过 load 事件
    lightboxImg.addEventListener('load', onLoad);
    lightboxImg.addEventListener('error', onError);
    lightboxImg.src = src;

    // 浏览器缓存：赋 src 后可能已是 complete，load 不一定再触发
    if (lightboxImg.complete && lightboxImg.naturalWidth) {
      lightboxImg.removeEventListener('load', onLoad);
      lightboxImg.removeEventListener('error', onError);
      finishImageLayout(src, token);
    }
    updateChrome();
  }

  function close() {
    layoutToken++;
    lightbox.style.display = 'none';
    lightboxVideo.src = '';
    lightboxPlayer.style.display = 'none';
    lightboxImg.style.display = '';
    viewport.style.display = '';
    viewport.classList.remove('is-scrollable');
    clearInlineSize();
    gallery = [];
    galleryIndex = 0;
    mode = null;
    updateChrome();
    unmountScrollLock();
    if (prevBtn) prevBtn.hidden = true;
    if (nextBtn) nextBtn.hidden = true;
    if (counterEl) counterEl.hidden = true;
  }

  function go(delta: number) {
    if (mode !== 'image' || !isMulti()) return;
    galleryIndex = (galleryIndex + delta + gallery.length) % gallery.length;
    showGalleryImage();
  }

  function buildEmbedUrl(url: string) {
    if (!url) return url;
    try {
      var parsed = new URL(url, window.location.origin);
      if (parsed.hostname.indexOf('bilibili.com') !== -1) {
        parsed.searchParams.set('autoplay', '1');
        parsed.searchParams.set('danmaku', '0');
        parsed.searchParams.set('high_quality', '1');
        return parsed.toString();
      }
    } catch (err) {}
    if (/[?&]autoplay=/.test(url)) return url;
    return url + (url.indexOf('?') === -1 ? '?' : '&') + 'autoplay=1';
  }

  function getBilibiliPageUrl(embedUrl: string) {
    try {
      var parsed = new URL(embedUrl, window.location.origin);
      var bvid = parsed.searchParams.get('bvid');
      if (bvid) return 'https://www.bilibili.com/video/' + bvid;
      var aid = parsed.searchParams.get('aid');
      if (aid) return 'https://www.bilibili.com/video/av' + aid;
    } catch (err) {}
    return '';
  }

  function openVideo(videoUrl: string) {
    mode = 'video';
    gallery = [];
    galleryIndex = 0;
    viewport.classList.remove('is-scrollable');
    clearInlineSize();
    updateChrome();
    viewport.style.display = 'none';
    lightboxImg.style.display = 'none';
    lightboxPlayer.style.display = 'flex';
    lightboxVideo.src = buildEmbedUrl(videoUrl);
    if (lightboxFallback) {
      var pageUrl = getBilibiliPageUrl(videoUrl);
      if (pageUrl) {
        lightboxFallback.href = pageUrl;
        lightboxFallback.style.display = '';
      } else {
        lightboxFallback.style.display = 'none';
      }
    }
    mountLightbox();
    lightbox.style.display = 'flex';
  }

  function parseImages(cardItem: Element): string[] {
    try {
      var raw = cardItem.getAttribute('data-images') || '[]';
      var list = JSON.parse(raw);
      if (Array.isArray(list)) {
        return list.filter(function(u) { return typeof u === 'string' && u; });
      }
    } catch (err) {}
    var img = cardItem.querySelector('.card-figure img') as HTMLImageElement | null;
    return img ? [img.currentSrc || img.src] : [];
  }

  function openPhotography(cardItem: Element) {
    mode = 'image';
    lightboxPlayer.style.display = 'none';
    lightboxImg.style.display = '';
    viewport.style.display = '';
    gallery = parseImages(cardItem);
    galleryIndex = 0;
    mountLightbox();
    lightbox.style.display = 'flex';
    showGalleryImage();
  }

  document.addEventListener('click', function(e) {
    var target = e.target as HTMLElement;
    var cardFigure = target.closest('.card-figure');
    if (!cardFigure) return;
    var cardItem = cardFigure.closest('.card-item');
    if (!cardItem) return;

    var videoUrl = cardItem.getAttribute('data-video') || '';
    var groups = '';
    try {
      groups = JSON.parse(cardItem.getAttribute('data-groups') || '[]');
    } catch(err) {}
    var isPhotography = groups.indexOf('photography') !== -1;

    if (!videoUrl && !isPhotography) return;

    e.preventDefault();

    if (videoUrl) {
      openVideo(videoUrl);
      return;
    }

    openPhotography(cardItem);
  });

  lightbox.addEventListener('click', function(e) {
    if (e.target === lightbox || e.target === viewport) close();
  });
  if (lightboxPlayer) {
    lightboxPlayer.addEventListener('click', function(e) {
      e.stopPropagation();
    });
  }
  if (lightboxClose) {
    lightboxClose.addEventListener('click', function(e) {
      e.stopPropagation();
      close();
    });
  }
  if (prevBtn) {
    prevBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      go(-1);
    });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      go(1);
    });
  }

  lightboxImg.addEventListener('click', function(e) {
    e.stopPropagation();
  });

  window.addEventListener('resize', function() {
    if (lightbox.style.display !== 'flex' || mode !== 'image') return;
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(adaptImageLayout, 80);
  });
  window.addEventListener('orientationchange', function() {
    window.setTimeout(adaptImageLayout, 120);
  });

  document.addEventListener('keydown', function(e) {
    if (lightbox.style.display !== 'flex') return;
    if (e.key === 'Escape') close();
    if (mode === 'image' && isMulti()) {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      }
    }
  });

  // 移动端组图左右滑动切换
  var touchStartX = 0;
  var touchStartY = 0;
  viewport.addEventListener('touchstart', function(e) {
    if (mode !== 'image' || !isMulti() || e.touches.length !== 1) return;
    touchStartX = e.touches[0].clientX;
    touchStartY = e.touches[0].clientY;
  }, { passive: true });
  viewport.addEventListener('touchend', function(e) {
    if (mode !== 'image' || !isMulti() || !e.changedTouches.length) return;
    var dx = e.changedTouches[0].clientX - touchStartX;
    var dy = e.changedTouches[0].clientY - touchStartY;
    if (Math.abs(dx) < 48 || Math.abs(dx) < Math.abs(dy)) return;
    go(dx < 0 ? 1 : -1);
  }, { passive: true });
})();
</script>

<style lang="scss">
.tag-original{
  display: inline-block;
  height: auto;
  padding: 0;
  margin-right: 0.4rem;
  line-height: inherit;
  font-size: 0.7em;
  font-weight: 500;
  letter-spacing: 0.08em;
  color: var(--color-400);
  background: transparent;
  border-radius: 0;
  vertical-align: baseline;
}
.card{
    &-list{
        display: flex;
        flex-wrap: wrap;
        width: 100%;
        margin: 1.5rem auto 3rem;
    }
    /* 入场只动画 opacity，勿动 transform——Shuffle 靠 inline transform 定位卡片 */
    &-item{
        float: left;
        margin-bottom: 2rem;
        opacity: 0;
        animation: card-enter 0.65s ease forwards;
        animation-delay: var(--stagger, 0ms);
    }
    /* Shuffle 隐形量宽元素：与卡片同列宽类，高度为 0，不参与展示 */
    :global(.my-sizer-element) {
        visibility: hidden;
        height: 0 !important;
        min-height: 0 !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        margin: 0 !important;
        overflow: hidden;
        pointer-events: none;
        border: 0 !important;
    }
    &-body{
        font-size: 0;
    }
    &-figure{
        width: 100%;
        height: auto;
        max-width: 100%;
        aspect-ratio: 3 / 4;
        background-color: rgba(0,0,0,.03);
        border-radius: 0;
        display: block;
        position: relative;
        overflow: hidden;
        border: none;
        &__img{
            position: absolute;
            width: 100%;
            height: 100%;
            left: 0;
            top: 0;
            object-fit: cover;
            transition: transform 0.7s ease, filter 0.5s ease;
        }
        &[data-has-video="true"]::after {
            content: '';
            position: absolute;
            left: 50%;
            top: 50%;
            width: 48px;
            height: 48px;
            margin: -24px 0 0 -24px;
            border-radius: 50%;
