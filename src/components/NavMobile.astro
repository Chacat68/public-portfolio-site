---
import {nav} from '../data/content';
import ThemeToggle from './ThemeToggle.astro';
---

<div class="mobile-header">
	<button type="button" class="hamburger hamburger-toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-nav">
		<span></span>
	</button>
	<nav class="m-nav" id="mobile-nav" aria-label="移动端导航">
		<div class="m-nav-wrap">
			<ul class="m-menu">
				{nav.items?.map(item => (
					<li class="m-menu-li">
						<a
							aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
							class:list={[
								'm-menu__link l',
								{
									active: Astro.url.pathname === item.href ||
										(item.href !== '/' && Astro.url.pathname.startsWith(item.href)),
								},
							]}
							href={item.href}
							target={item.target || '_self'}
						>
							{item.label}
						</a>
					</li>
				))}
				<li class="m-menu-li">
					<div class="theme-toggle">
						<ThemeToggle />
					</div>
				</li>
			</ul>
		</div>
	</nav>
	<div class="m-nav-mask" hidden></div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.hamburger-toggle') as HTMLButtonElement | null;
    const nav = document.querySelector('.m-nav');
    const mask = document.querySelector('.m-nav-mask') as HTMLElement | null;
    if (!btn || !nav || !mask) return;

    const setOpen = (open: boolean) => {
      btn.classList.toggle('close-line', open);
      nav.classList.toggle('is-active', open);
      mask.classList.toggle('is-active', open);
      mask.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      document.documentElement.classList.toggle('nav-open', open);
      document.body.style.overflow = open ? 'hidden' : '';
    };

    btn.addEventListener('click', () => setOpen(!nav.classList.contains('is-active')));
    mask.addEventListener('click', () => setOpen(false));
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  });
</script>
<style lang="scss">
.pc-nav {
  display: none;
}

@media (min-width: 768px) {
  .mobile-header {
    display: none;
  }
  .hamburger,
  .m-nav,
  .m-nav-mask {
    display: none !important;
  }
}

.hamburger-toggle {
  position: relative;
  z-index: 10001;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  border: none;
  background: transparent;
  padding: 0;
  transition: all 0.3s;

  span {
    width: 22px;
    height: 2px;
    display: block;
    position: relative;
    background: var(--color-100);
    transition: all 0.2s ease-out;

    &::before,
    &::after {
      content: "";
      width: 22px;
      height: 2px;
      position: absolute;
      left: 0;
      background: var(--color-100);
      transition: all 0.3s ease-out;
    }

    &::before {
      top: -7px;
    }

    &::after {
      top: 7px;
    }
  }

  &.close-line span {
    background: transparent;

    &::before {
      transform: rotate(45deg);
      top: 0;
    }

    &::after {
      transform: rotate(-45deg);
      top: 0;
    }
  }
}

.m-nav {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100dvh;
  background-color: var(--color-999);
  transition: transform 0.45s ease;
  transform: translateX(100%);
  z-index: 10000;
  overflow: auto;
  padding:
    max(5rem, calc(env(safe-area-inset-top, 0px) + 4rem))
    max(1.5rem, env(safe-area-inset-right, 0px))
    max(2rem, env(safe-area-inset-bottom, 0px))
    max(1.5rem, env(safe-area-inset-left, 0px));
  box-sizing: border-box;

  &.is-active {
    transform: translateX(0);
  }
}

.m-nav-wrap {
  position: relative;
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  min-height: 60%;
}

.m-nav-mask {
  position: fixed;
  inset: 0;
  opacity: 0;
  background-color: rgba(0, 0, 0, 0.35);
  z-index: 9990;
  transition: opacity 0.35s ease;
  pointer-events: none;

  &[hidden] {
    display: none !important;
  }

  &.is-active {
    opacity: 1;
    pointer-events: auto;
  }
}

.m-menu {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 0.25rem;
  width: 100%;
  margin: 0;
  padding: 0;
  list-style: none;

  &-li {
    position: relative;
    width: 100%;
    text-align: left;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border, rgba(0, 0, 0, 0.06));

    a.m-menu__link {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-size: clamp(1.35rem, 5vw, 1.75rem);
      color: var(--color-100);
      text-decoration: none;

      &.active {
        color: var(--color-0);
      }
    }
  }
}
</style>
