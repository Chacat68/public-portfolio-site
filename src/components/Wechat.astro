---
/**
 * 微信预约弹层
 * 将二维码放到 public/assets/wechat-qr.jpg（或 .png / .webp）即可显示；
 * 未放置时不请求图片，直接展示邮件与 B 站备用联系方式。
 */
import fs from 'node:fs';
import path from 'node:path';
import { siteConfig } from '../data/content';

const qrCandidates = [
	'assets/wechat-qr.jpg',
	'assets/wechat-qr.png',
	'assets/wechat-qr.webp',
] as const;

const qrFile = qrCandidates.find((rel) =>
	fs.existsSync(path.join(process.cwd(), 'public', rel))
);
const qrSrc = qrFile ? `/${qrFile}` : null;
---

<div id="popup-wechat" class="wechat-popup" hidden>
	<div class="wechat-mask" aria-hidden="true"></div>
	<div class="wechat-dialog" role="dialog" aria-modal="true" aria-labelledby="wechat-title">
		<button type="button" id="close-wechat" class="wechat-close" aria-label="关闭">×</button>
		<p id="wechat-title" class="wechat-title">微信预约</p>
		<p class="wechat-desc">
			{qrSrc ? '扫码添加，沟通拍摄需求与档期' : '二维码即将上线，请先通过邮件或 B 站联系'}
		</p>
		<figure class="wechat-qr">
			{qrSrc ? (
				<img
					src={qrSrc}
					alt={`${siteConfig.siteName} 微信二维码`}
					width="200"
					height="200"
					loading="lazy"
				/>
			) : (
				<p class="wechat-qr-fallback">放置 public/assets/wechat-qr.jpg 后将在此显示二维码。</p>
			)}
		</figure>
		<div class="wechat-alt">
			<a href="mailto:colinwangq@163.com">colinwangq@163.com</a>
			<a href="https://space.bilibili.com/249294453" target="_blank" rel="noopener noreferrer">B 站私信</a>
		</div>
	</div>
</div>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		const popup = document.getElementById('popup-wechat');
		const closeWechat = document.getElementById('close-wechat');
		const wechatButtons = document.querySelectorAll('.wechat');
		const wechatMask = document.querySelector('.wechat-mask');

		function showPopup() {
			if (popup) {
				popup.removeAttribute('hidden');
				document.body.style.overflow = 'hidden';
			}
		}

		function hidePopup() {
			if (popup) {
				popup.setAttribute('hidden', '');
				document.body.style.overflow = '';
			}
		}

		wechatButtons.forEach((button) => {
			button.addEventListener('click', (e) => {
				e.preventDefault();
				showPopup();
			});
		});

		closeWechat?.addEventListener('click', hidePopup);
		wechatMask?.addEventListener('click', hidePopup);

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && popup && !popup.hasAttribute('hidden')) {
				hidePopup();
			}
		});
	});
</script>

<style>
	.wechat-popup[hidden] {
		display: none !important;
	}

	.wechat-popup {
		position: fixed;
		inset: 0;
		z-index: 10000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.5rem;
	}

	.wechat-mask {
		position: absolute;
		inset: 0;
		background: rgba(10, 10, 10, 0.55);
		backdrop-filter: blur(4px);
	}

	.wechat-dialog {
		position: relative;
		z-index: 1;
		width: min(100%, 360px);
		padding: 2rem 1.75rem 1.75rem;
		background: var(--color-999, #f7f7f5);
		border: 1px solid var(--border, #ececec);
		text-align: center;
	}

	.wechat-close {
		position: absolute;
		top: 0.5rem;
		right: 0.75rem;
		border: none;
		background: transparent;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--color-300);
		cursor: pointer;
	}

	.wechat-title {
		font-family: var(--font-display, var(--font-brand));
		font-size: 1.5rem;
		color: var(--color-0);
		margin-bottom: 0.35rem;
	}

	.wechat-desc {
		font-size: 0.875rem;
		color: var(--color-300);
		margin-bottom: 1.25rem;
	}

	.wechat-qr {
		margin: 0 auto 1.25rem;
		width: 200px;
		min-height: 120px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(0, 0, 0, 0.03);
	}

	.wechat-qr img {
		display: block;
		width: 200px;
		height: 200px;
		object-fit: contain;
	}

	.wechat-qr-fallback {
		font-size: 0.8125rem;
		color: var(--color-400);
		padding: 1rem;
		line-height: 1.5;
	}

	.wechat-alt {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.875rem;
	}

	.wechat-alt a {
		color: var(--color-200);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.wechat-alt a:hover {
		color: var(--color-0);
	}
</style>
