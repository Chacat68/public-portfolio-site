---
interface Props {
	href?: string;
	target?: string;
	variant?: 'primary' | 'secondary';
	/** 叠在深色影像底上时固定浅色描边，不受亮/暗主题影响 */
	tone?: 'default' | 'on-dark';
	class?: string;
}

const {
	href = '#',
	target = '_self',
	variant = 'primary',
	tone = 'default',
	class: className = '',
} = Astro.props;
const rel = target === '_blank' ? 'noopener noreferrer' : undefined;
---

<a
	href={href}
	target={target}
	rel={rel}
	class:list={['cta', `cta--${variant}`, tone === 'on-dark' && 'cta--on-dark', className]}
>
	<slot />
</a>

<style>
	.cta {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		min-width: 148px;
		padding: 0.95em 1.75em;
		font-size: var(--text-sm);
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.1;
		text-decoration: none;
		white-space: nowrap;
		border-radius: var(--radius);
		border: 1px solid transparent;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			border-color 0.25s ease,
			transform 0.25s ease;
	}

	.cta--primary {
		background: var(--gallery-ink, #1a1a1a);
		color: #f7f7f5 !important;
		border-color: var(--gallery-ink, #1a1a1a);
	}

	.cta--primary:hover,
	.cta--primary:focus-visible {
		background: #2a2a2a;
		border-color: #2a2a2a;
		transform: translateY(-1px);
	}

	.cta--secondary {
		background: transparent;
		color: var(--gallery-ink, #1a1a1a) !important;
		border-color: rgba(26, 26, 26, 0.35);
	}

	.cta--secondary:hover,
	.cta--secondary:focus-visible {
		border-color: var(--gallery-ink, #1a1a1a);
		background: rgba(26, 26, 26, 0.04);
		transform: translateY(-1px);
	}

	:global(.theme-dark) .cta--primary {
		background: #f0f0ee;
		color: #141414 !important;
		border-color: #f0f0ee;
	}

	:global(.theme-dark) .cta--primary:hover,
	:global(.theme-dark) .cta--primary:focus-visible {
		background: #ffffff;
		border-color: #ffffff;
	}

	:global(.theme-dark) .cta--secondary {
		color: #f0f0ee !important;
		border-color: rgba(240, 240, 238, 0.35);
	}

	:global(.theme-dark) .cta--secondary:hover,
	:global(.theme-dark) .cta--secondary:focus-visible {
		border-color: #f0f0ee;
		background: rgba(240, 240, 238, 0.06);
	}

	/* 深色底上的次按钮：亮色主题下也保持浅色文字/描边 */
	.cta--secondary.cta--on-dark {
		color: #f7f7f5 !important;
		border-color: rgba(247, 247, 245, 0.7);
	}

	.cta--secondary.cta--on-dark:hover,
	.cta--secondary.cta--on-dark:focus-visible {
		color: #ffffff !important;
		border-color: #f7f7f5;
		background: rgba(247, 247, 245, 0.12);
	}

	@media (max-width: 767.98px) {
		.cta {
			min-width: 0;
			min-height: 44px;
			padding: 0.9em 1.25em;
		}
	}
</style>
